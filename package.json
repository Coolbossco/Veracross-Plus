{
  "name": "veracross-plus",
  "version": "0.2.1",
  "description": "Enhanced Veracross portal experience with homework checklists on timeline and daily schedule pages, grade estimation, custom assignments, and navigation improvements",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "package:chrome": "cd dist/chrome && zip -r ../veracross-plus-chrome.zip .",
    "package:firefox": "cd dist/firefox && zip -r ../veracross-plus-firefox.zip .",
    "release": "npm run clean && npm run build && npm run package:chrome"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "veracross",
    "student-portal",
    "productivity"
  ],
  "author": "Veracross Plus Team",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "files": [
    "src/",
    "dist/",
    "manifest*.json"
  ]
}
