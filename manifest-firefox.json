{
  "manifest_version": 2,
  "name": "Veracross Plus",
  "version": "0.2.1",
  "description": "Enhanced Veracross with homework checkboxes on timeline and daily schedule, grade estimator, and custom assignments",
  "permissions": [
    "storage",
    "*://*.veracross.com/*",
    "*://*.myveracross.com/*",
    "*://portals.veracross.com/*",
    "*://portals-embed.veracross.com/*"
  ],

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.veracross.com/*",
        "*://*.myveracross.com/*",
        "*://portals.veracross.com/*",
        "*://portals-embed.veracross.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Veracross Plus",
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": ["window.html"]
}
