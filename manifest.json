{
    "manifest_version": 3,
    "name": "Veracross Plus",
    "description": "Veracross Plus adds features to the service Veracross.com that are frequently requested",
    "version": "0.1.0",
    "permissions": ["storage"],
    "host_permissions": [
      "*://*.veracross.com/*",
      "*://*.myveracross.com/*",
      "*://portals.veracross.com/*",
      "*://portals-embed.veracross.com/*"
    ],
    "content_scripts": [
      {
        "matches": [
          "*://*.veracross.com/*",
          "*://*.myveracross.com/*",
          "*://portals.veracross.com/*",
          "*://portals-embed.veracross.com/*"
        ],
        "js": ["content.js"],
        "css": ["styles.css"],
        "run_at": "document_end",
        "all_frames": true
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Veracross Plus"
    },
    "options_page": "options.html"
  }