{
  "manifest_version": 3,
  "name": "Veracross Plus",
  "description": "Enhanced Veracross with homework checkboxes on timeline and daily schedule, grade estimator, and custom assignments",
  "version": "0.7.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "veracross-plus@codegraph.cc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["technicalAndInteraction"]
      }
    }
  },
  "permissions": ["storage", "alarms", "notifications"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://stats.codegraph.cc/*",
    "https://rollout.codegraph.cc/*",
    "https://www.sagedining.com/*",
    "*://*.veracross.com/*",
    "*://*.myveracross.com/*",
    "*://portals.veracross.com/*",
    "*://portals-embed.veracross.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.veracross.com/*",
        "*://*.myveracross.com/*",
        "*://portals.veracross.com/*",
        "*://portals-embed.veracross.com/*"
      ],
      "js": ["src/content/theme-boot.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.veracross.com/*",
        "*://*.myveracross.com/*",
        "*://portals.veracross.com/*",
        "*://portals-embed.veracross.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.legacy.html",
    "default_title": "Veracross Plus",
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "src/options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/popup/window.legacy.html"],
      "matches": [
        "*://*.veracross.com/*",
        "*://*.myveracross.com/*",
        "*://portals.veracross.com/*",
        "*://portals-embed.veracross.com/*",
        "<all_urls>"
      ]
    }
  ]
}
