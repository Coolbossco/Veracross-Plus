{
  "manifest_version": 3,
  "name": "Veracross Plus",
  "description": "Veracross Plus adds features to the service Veracross.com that are frequently requested",
  "version": "0.1.2",

  "permissions": ["storage"],
  "host_permissions": [
    "*://*.veracross.com/*",
    "*://*.myveracross.com/*",
    "*://portals.veracross.com/*",
    "*://portals-embed.veracross.com/*"
  ],

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.veracross.com/*",
        "*://*.myveracross.com/*",
        "*://portals.veracross.com/*",
        "*://portals-embed.veracross.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Veracross Plus",
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    }
  },

  "options_page": "options.html"
}
