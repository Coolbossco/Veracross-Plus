{
  "manifest_version": 3,
  "name": "Veracross Plus",
  "description": "Enhanced Veracross with homework checkboxes on timeline and daily schedule, grade estimator, and custom assignments",
  "version": "0.3.4",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.veracross.com/*",
    "*://*.myveracross.com/*",
    "*://portals.veracross.com/*",
    "*://portals-embed.veracross.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.veracross.com/*",
        "*://*.myveracross.com/*",
        "*://portals.veracross.com/*",
        "*://portals-embed.veracross.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Veracross Plus",
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "src/options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/popup/window.html"],
      "matches": ["*://*.veracross.com/*", "*://*.myveracross.com/*", "*://portals.veracross.com/*", "*://portals-embed.veracross.com/*"]
    }
  ]
}
