DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/remote_sync?schema=public"
JWT_SECRET="replace-with-access-secret"
REFRESH_TOKEN_SECRET="replace-with-refresh-secret"
EXTENSION_SHARED_SECRET=""
ALLOWED_ORIGINS="chrome-extension://your-extension-id,https://localhost:5173"
TOKEN_ISSUER="veracross-plus-sync"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
BCRYPT_ROUNDS="10"
RATE_LIMIT_AUTH_WINDOW="60000"
RATE_LIMIT_AUTH_MAX="60"

